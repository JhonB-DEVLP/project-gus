# Copy to .env.local and fill in. Never commit real values.

# Public URL of the site, no trailing slash. Used for metadataBase, canonical and sitemap.
# Inlined at build time: redeploy after changing it. If empty on Vercel, the
# production domain (VERCEL_PROJECT_PRODUCTION_URL, set by Vercel) is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis REST credentials (rate limit + message store).
# Confirm the names in the Upstash console; the Vercel integration may name them
# KV_REST_API_URL / KV_REST_API_TOKEN instead, which are read as a fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret for HMAC-SHA-256 of the sender's IP before it is used as the rate limit key.
# Any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Required unless CONTACT_DRIVER=memory.
RATE_LIMIT_SALT=

# Resend API key for the contact email.
RESEND_API_KEY=

# Inbox that receives contact messages.
CONTACT_EMAIL_TO=

# Sender address, on a domain verified in Resend (e.g. "Portfolio <contact@example.com>").
CONTACT_EMAIL_FROM=

# "memory" uses in-memory store, mailer and rate limiter (tests, E2E, CI). Leave empty in production.
CONTACT_DRIVER=
